-<script>
-// ── Конфигурация защиты ──────────────────────────────────
-const SESSION_KEY  = 'postai_auth';
-const SESSION_TTL  = 8 * 60 * 60 * 1000; // 8 часов
-const MAX_ATTEMPTS = 5;
-const LOCKOUT_TIME = 15 * 60 * 1000;     // 15 минут блокировки
-const ATTEMPTS_KEY = 'postai_attempts';
-
-// ── Хеш пароля (SHA-256) ─────────────────────────────────
-// Пароль хранится не в открытом виде, а как хеш
-// Замените значение ниже хешем вашего пароля
-// Текущий пароль: измените SCHEDULER_PASSWORD в Vercel env
-// и обновите хеш через: https://emn178.github.io/online-tools/sha256.html
-const PASSWORD_HASH = '__SCHEDULER_PASSWORD_HASH__';
-
-async function sha256(message) {
-  const msgBuffer = new TextEncoder().encode(message);
-  const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
-  const hashArray  = Array.from(new Uint8Array(hashBuffer));
-  return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
-}
-
-// ── Проверка сессии при загрузке ────────────────────────
-window.addEventListener('load', () => {
-  const session = JSON.parse(localStorage.getItem(SESSION_KEY) || 'null');
-  if (session && Date.now() - session.ts < SESSION_TTL) {
-    showMainScreen();
-  }
-  updateUtcClock();
-  setInterval(updateUtcClock, 30000);
-});
-
-// ── Логин ────────────────────────────────────────────────
-async function handleLogin() {
-  const loginBtn = document.getElementById('loginBtn');
-  const errorDiv = document.getElementById('loginError');
-  const attemptsDiv = document.getElementById('attemptsLeft');
-  const password = document.getElementById('passwordInput').value;
-
-  // Проверяем блокировку
-  const attemptsData = JSON.parse(localStorage.getItem(ATTEMPTS_KEY) || '{"count":0,"ts":0}');
-  if (attemptsData.count >= MAX_ATTEMPTS) {
-    const remaining = Math.ceil((LOCKOUT_TIME - (Date.now() - attemptsData.ts)) / 60000);
-    if (remaining > 0) {
-      errorDiv.textContent = `Слишком много попыток. Подождите ${remaining} мин.`;
-      errorDiv.style.display = 'block';
-      return;
-    } else {
-      localStorage.removeItem(ATTEMPTS_KEY);
-    }
-  }
-
-  loginBtn.disabled = true;
-  loginBtn.textContent = 'Проверяю...';
-
-  try {
-    const response = await fetch('/api/check-password', {
-      method: 'POST',
-      headers: { 'Content-Type': 'application/json' },
-      body: JSON.stringify({ password }),
-    });
-
-    const data = await response.json();
-
-    if (data.ok) {
-      // Сбрасываем счётчик попыток
-      localStorage.removeItem(ATTEMPTS_KEY);
-      // Сохраняем сессию
-      localStorage.setItem(SESSION_KEY, JSON.stringify({ ts: Date.now() }));
-      showMainScreen();
-    } else {
-      // Увеличиваем счётчик неудачных попыток
-      const newAttempts = { count: attemptsData.count + 1, ts: Date.now() };
-      localStorage.setItem(ATTEMPTS_KEY, JSON.stringify(newAttempts));
-
-      const remaining = MAX_ATTEMPTS - newAttempts.count;
-      errorDiv.textContent = 'Неверный пароль.';
-      errorDiv.style.display = 'block';
-
-      if (remaining > 0) {
-        attemptsDiv.textContent = `Осталось попыток: ${remaining}`;
-      } else {
-        attemptsDiv.textContent = `Вход заблокирован на 15 минут`;
-      }
-    }
-  } catch {
-    errorDiv.textContent = 'Ошибка соединения. Попробуйте ещё раз.';
-    errorDiv.style.display = 'block';
-  }
-
-  loginBtn.disabled = false;
-  loginBtn.textContent = 'Войти →';
-}
