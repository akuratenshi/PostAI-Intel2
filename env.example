# Frontend public key; it may be pk_test_ during migration. Never put server secrets in VITE_*.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Explicit origins, comma-separated. Add exact staging URL; do not allow all vercel.app origins.
CLERK_AUTHORIZED_PARTIES=https://postai.ink
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
KV_REST_API_URL=
KV_REST_API_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
TELEGRAM_BOT_TOKEN=
CRON_SECRET=

# Change only when an actual more frequent scheduler has been configured.
VITE_SCHEDULER_CADENCE_HINT=Очередь проверяется раз в сутки и обрабатывает одну публикацию за запуск.
